{
  "backend_branch": "elwin/for-546-mcp-contract-fixes",
  "export_sha256": "a9884eb85e99fa7d31767760697ab7f1bd25fb672ed99c15e4e7eb66ac08d89b",
  "schema_version": "1.9.0",
  "tool": {
    "name": "generation_sound_effect",
    "scope": "generation:write",
    "conditional_scopes": {
      "delivery.mode=publish": [
        "publication:write"
      ]
    },
    "description": "Generate game sound effects. Optional delivery publish/roblox requires publication:write and publishes each retained output through the durable Audio publisher. Direct or omitted delivery returns file results and never publishes.",
    "input_schema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "description": "Stable caller-chosen idempotency key. Reuse only with identical parameters."
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "delivery": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "direct"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "publish"
                },
                "platform": {
                  "type": "string",
                  "const": "roblox"
                },
                "connection_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "mode",
                "platform"
              ],
              "additionalProperties": false
            }
          ],
          "description": "How finished audio is delivered. Omitted or direct returns ForgeGUI file results only. publish/roblox additionally publishes each retained MP3 output as a Roblox Audio asset owned by the explicitly selected Personal connection creator, with connection_id required for new publish requests (legacy requests remain replayable); credentials remain server-only, and each output reports its own publication status and decimal-string asset id once ready."
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 30
        },
        "audio_category": {
          "type": "string",
          "enum": [
            "ui",
            "combat",
            "ambient",
            "movement",
            "collectible",
            "notification",
            "default"
          ]
        },
        "loopable": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "request_id",
        "prompt"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "backend_commit": "3cc98a44aa56fdf12ec697a6c3787e884601ea31"
}
